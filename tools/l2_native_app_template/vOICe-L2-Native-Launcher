#!/bin/zsh
set -u

contents_dir="${0:A:h:h}"
runtime_dir="${contents_dir}/Resources/runtime"
server_port="8147"
app_url="http://127.0.0.1:${server_port}/web/index.html"
expected_title="<title>vOICe soundscape localization</title>"
expected_geometry="soundscape-native-178x64-v1"
chrome_app="/Applications/Google Chrome.app"
server_log="/tmp/voice_l2_native_server.log"
launcher_log="/tmp/voice_l2_native_launcher.log"
primary_test_data_dir="${HOME}/Library/Application Support/vOICe L2 Native Aspect/test_data"
mirror_test_data_dir="${HOME}/Dev/Lossfunk/ir-results/l2-native-aspect"

exec >>"$launcher_log" 2>&1
print "$(/bin/date -u '+%Y-%m-%dT%H:%M:%SZ') launcher invoked"

show_error() {
  /usr/bin/osascript \
    -e 'on run argv' \
    -e 'display dialog (item 1 of argv) buttons {"OK"} default button "OK" with icon stop' \
    -e 'end run' \
    -- "$1"
}

page_is_ready() {
  local page script
  page="$(/usr/bin/curl -fsS --max-time 1 "$app_url" 2>/dev/null)" || return 1
  script="$(/usr/bin/curl -fsS --max-time 1 "http://127.0.0.1:${server_port}/web/app.js" 2>/dev/null)" || return 1
  [[ "$page" == *"$expected_title"* && "$script" == *"$expected_geometry"* ]]
}

for required_path in \
  "$runtime_dir/server.py" \
  "$runtime_dir/web/index.html" \
  "$runtime_dir/web/app.js" \
  "$runtime_dir/stimuli/4x3/manifest.json"; do
  if [[ ! -f "$required_path" ]]; then
    show_error $'The vOICe L2 Native Aspect application is incomplete.\n\nMissing: '"${required_path}"
    exit 1
  fi
done

listener_pid="$(/usr/sbin/lsof -tiTCP:"$server_port" -sTCP:LISTEN 2>/dev/null || true)"
if [[ -n "$listener_pid" ]]; then
  if ! page_is_ready; then
    show_error "Port ${server_port} is already being used by another service. Nothing was stopped."$'\n\n'"Close that service and try again."
    exit 1
  fi
else
  /bin/mkdir -p "$primary_test_data_dir" "$mirror_test_data_dir"
  cd "$runtime_dir" || exit 1
  IR_VOICE_TEST_DATA_DIR="$primary_test_data_dir" \
  IR_VOICE_TEST_DATA_MIRROR_DIR="$mirror_test_data_dir" \
  nohup /usr/bin/env python3 server.py "$server_port" \
    >"$server_log" 2>&1 </dev/null &
fi

server_ready=0
for _attempt in {1..32}; do
  if page_is_ready; then
    server_ready=1
    break
  fi
  /bin/sleep 0.25
done
if [[ "$server_ready" -ne 1 ]]; then
  show_error $'The vOICe L2 Native Aspect server did not become ready.\n\nSee '"${server_log}"$' for details.'
  exit 1
fi

if [[ "${1:-}" == "--check-only" ]]; then
  print "vOICe L2 Native Aspect launcher check passed: ${app_url}"
  exit 0
fi

if [[ -d "$chrome_app" ]]; then
  /usr/bin/open -na "Google Chrome" --args "--app=${app_url}" --start-fullscreen
else
  /usr/bin/open "$app_url"
fi
print "$(/bin/date -u '+%Y-%m-%dT%H:%M:%SZ') browser launch requested: ${app_url}"
